

\newenvironment{lattice}[3]{\begin{tikzpicture}[x = {(1cm,0cm)},
  y  = {(0cm,1cm)},
  z  = {(0.35cm,0.35cm)},
  scale = 0.8]

  % direct lattice constants
  \def\dax{2}
  \def\day{0.3}
  \def\daz{0.2}
  \def\dby{1.3}

  % reciprocal lattice constants
  % a* = (0.5 -0.115385 -0.1)
  % b* = (0 0.769231 0)
  % c* = (0 0 1)
  \def\dhx{0.5}
  \def\dhy{-0.115}
  \def\dhz{-0.1}
  \def\dky{0.77}
  \def\dlz{1}

  % grid
  \foreach \y in {0,1,...,#2}
  \foreach \z in {0,1,...,#3}
  \draw[style=help lines,color=black] (\dax*0+\day*\y+\daz*\z,\dby*\y,\z)
  -- (\dax*#1+\day*\y+\daz*\z,\dby*\y,\z);

  \foreach \x in {0,1,...,#1}
  \foreach \z in {0,1,...,#3}
  \draw[style=help lines,color=black] (\dax*\x+\day*0+\daz*\z,\dby*0,\z)
  -- (\dax*\x+\day*#2+\daz*\z,\dby*#2,\z);

  \foreach \x in {0,1,...,#1}
  \foreach \y in {0,1,...,#2}
  \draw[style=help lines,color=black] (\dax*\x+\day*\y+\daz*0,\dby*\y,0)
  -- (\dax*\x+\day*\y+\daz*#3,\dby*\y,#3);

  % atoms
  \foreach \x in {0,1,...,#1}
  \foreach \y in {0,1,...,#2}
  \foreach \z in {0,1,...,#3}
  {
  \shade[ball color=red!70] (\dax*\x+\day*\y+\daz*\z,\dby*\y,\z) circle (.12cm);
  \shade[ball color=blue!70] (\dax*\x+\day*\y+\daz*\z-0.2,\dby*\y+0.2,\z) circle (.08cm);
  }


}{\end{tikzpicture}}

\newcommand{\unitCell}[1]{
   \draw[->, >=latex, ultra thick] (#1*\day,#1*\dby,0) -> node[left] {$\vec{b}$}
   +(\day,\dby,0);
   \draw[->, >=latex,  ultra thick, color=black]
   (#1*\day,#1*\dby,0) -> node[below] {$\vec{a}$} +(\dax,0,0);
   \draw[->, >=latex,  ultra thick, color=black]
   (#1*\day,#1*\dby,0) -> +(\daz,0,1);}

\newcommand{\latticeVector}[3]{
  \draw[->, >=latex, ultra thick, color=green!70!black] (0,0,0) ->
  +(#1*\dax+#2*\day+#3*\daz,#2*\dby,#3);
}


\newcommand{\latticePoint}[3]{
  (#1*\dax+#2*\day+#3*\daz,#2*\dby,#3)
}

\newcommand{\reciprocalVector}[3]{
  (#1*\dhx,#1*\dhy+#2*\dky,#1*\dhz+#3*\dlz)
}

